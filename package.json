{
  "name": "xe-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run schemas",
    "build": "astro check && astro build",
    "check:build": "node scripts/check-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "migrate": "node scripts/migrate.mjs",
    "enrich:speakers": "node scripts/enrich-event-speakers.mjs",
    "enrich:materials": "node scripts/enrich-event-materials.mjs",
    "schemas": "node scripts/generate-json-schemas.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit:lighthouse:mobile": "node scripts/audit-lighthouse.mjs --preset=mobile",
    "audit:lighthouse:desktop": "node scripts/audit-lighthouse.mjs --preset=desktop",
    "prepare": "lefthook install || true",
    "eval:webmcp:ollama": "node scripts/eval-webmcp-ollama.mjs",
    "eval:webmcp:docker:up": "docker compose -f docs/webmcp/compose.ollama.yml up -d --wait --wait-timeout 60",
    "eval:webmcp:docker:up:gpu": "docker compose -f docs/webmcp/compose.ollama.yml -f docs/webmcp/compose.ollama.nvidia.yml up -d --wait --wait-timeout 60",
    "eval:webmcp:docker:pull": "node scripts/prepare-webmcp-ollama-docker.mjs",
    "eval:webmcp:docker:down": "docker compose -f docs/webmcp/compose.ollama.yml down",
    "eval:webmcp:docker:logs": "docker compose -f docs/webmcp/compose.ollama.yml logs --no-color",
    "eval:webmcp:docker:config": "docker compose -f docs/webmcp/compose.ollama.yml config --quiet"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "astro": "^7.4.2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.4",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.21",
    "cheerio": "^1.2.0",
    "lefthook": "^2.2.2",
    "lighthouse": "^13.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "remark-parse": "^11.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^5.0.5",
    "webmcp-types": "^0.1.10",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "satori": {
      "fflate": "^0.7.5"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  }
}
